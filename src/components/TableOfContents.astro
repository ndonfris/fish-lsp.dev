---
/**
 * "On this page" TOC: a button that opens a popover of the page's h2/h3
 * headings (nested), with a scrollspy that highlights the current section.
 *
 * Extracted from SecondHeader.astro — markup, styles, and behavior unchanged.
 * At the >=1500px breakpoint this positions itself as an absolutely-placed
 * rail (`position: absolute`), so it currently depends on being rendered
 * inside a positioned ancestor (SecondHeader's sticky `.second-header` bar).
 *
 * Heading `id`s are auto-generated by Astro's markdown pipeline.
 */
import type { MarkdownHeading } from 'astro';
import { Icon } from 'astro-icon/components';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;

// ── TOC: h2 sections with nested h3s ───────────────────────────────
type TocNode = MarkdownHeading & { children: MarkdownHeading[] };
const toc: TocNode[] = [];
for (const h of headings) {
  if (h.depth === 2) toc.push({ ...h, children: [] });
  else if (h.depth === 3 && toc.length) toc[toc.length - 1].children.push(h);
}
const hasToc = toc.length > 0;
---

{hasToc && (
  <nav class="sh-toc" aria-label="On this page" data-toc>
    <button
      type="button"
      class="sh-toc-btn"
      data-toc-toggle
      aria-controls="sh-toc-panel"
      aria-expanded="false"
      aria-haspopup="true"
    >
      <Icon name="list" class="sh-toc-icon" />
      <span class="sh-toc-btn-label">On this page</span>
      <span class="sh-caret" aria-hidden="true">▾</span>
    </button>

    <div id="sh-toc-panel" class="sh-panel sh-toc-panel">
      <p class="sh-toc-title">On this page</p>
      <ul class="sh-toc-list">
        {toc.map((h) => (
          <li>
            <a href={`#${h.slug}`} class="sh-toc-link" data-toc-link={h.slug}>{h.text}</a>
            {h.children.length > 0 && (
              <ul class="sh-toc-sub">
                {h.children.map((c) => (
                  <li>
                    <a href={`#${c.slug}`} class="sh-toc-link sh-toc-link--sub" data-toc-link={c.slug}>{c.text}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<style>
  /* ── TOC button ─────────────────────────────────────────────────── */
  .sh-toc { position: relative; flex-shrink: 0; }
  .sh-toc-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.28rem 0.6rem;
    cursor: pointer;
    transition: color 0.12s, border-color 0.12s;
  }
  .sh-toc-btn:hover { color: var(--text-primary); border-color: var(--fish-periwinkle); }
  .sh-toc-icon { display: block; width: 14px; height: 14px; flex-shrink: 0; }
  .sh-caret { flex-shrink: 0; font-size: 0.58rem; transition: transform 0.15s; }
  [data-toc-toggle][aria-expanded='true'] .sh-caret { transform: rotate(180deg); }

  /* On narrow screens the TOC collapses to a compact icon-only dropdown so the
     breadcrumb keeps the width it needs. */
  @media (max-width: 640px) {
    .sh-toc-btn-label { display: none; }
    .sh-toc-btn { padding: 0.28rem 0.45rem; }
  }

  /* ── Popover panel ──────────────────────────────────────────────── */
  .sh-panel {
    position: absolute;
    top: calc(100% + 6px);
    z-index: 30;
    max-height: 70vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
    display: none;
  }
  .sh-panel.open { display: block; }
  .sh-toc-panel { right: 0; min-width: 15rem; max-width: min(88vw, 22rem); padding: 0.5rem; }

  /* ── TOC list ───────────────────────────────────────────────────── */
  .sh-toc-title {
    display: none; /* only shown in the wide-mode gutter rail */
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .sh-toc-list, .sh-toc-sub { list-style: none; margin: 0; padding: 0; }
  .sh-toc-sub { margin-left: 0.75rem; }
  /* Roomier spacing between top-level entries. */
  .sh-toc-list > li + li { margin-top: 0.4rem; }
  .sh-toc-link {
    display: block;
    padding: 0.24rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.35;
    color: var(--text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    overflow-wrap: anywhere; /* break long tokens (e.g. fish_lsp_… headings) */
    transition: color 0.12s, border-color 0.12s;
  }
  .sh-toc-link--sub { font-size: 0.72rem; color: var(--text-dim); }
  .sh-toc-link:hover { color: var(--text-primary); }
  .sh-toc-link.is-active {
    color: var(--fish-periwinkle);
    border-left-color: var(--fish-periwinkle);
  }

  /* ── Wide: promote into an always-visible right-gutter rail ───────
     Above this width there's room outside the article (max-w-4xl = 56rem) to
     show the on-this-page list as a rail in the right whitespace. Positioned
     absolute relative to the nearest positioned ancestor (SecondHeader's
     sticky bar). The hidden button is still in the DOM for smaller
     breakpoints; at this size the panel is always shown. */
  @media (min-width: 1500px) {
    .sh-toc {
      position: absolute;
      top: calc(100% + 3rem);
      right: 1.5rem;
      width: 14rem;
      max-width: calc((100vw - 56rem) / 2 - 3rem);
      flex: none;
      pointer-events: auto;
    }
    .sh-toc-btn { display: none; }
    .sh-toc-panel {
      position: static;
      display: block;
      min-width: 0;
      max-width: none;
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      max-height: calc(100vh - var(--sh-top) - 4rem);
      overflow-y: auto;
    }
    .sh-toc-title { display: block; }
    .sh-toc-list > li + li { margin-top: 0.15rem; } /* tighter in the rail */
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((root) => {
    // ── Popover toggle ────────────────────────────────────────────
    const toggles = [...root.querySelectorAll<HTMLElement>('[data-toc-toggle]')];
    const panelOf = (t: HTMLElement) =>
      document.getElementById(t.getAttribute('aria-controls') ?? '');
    const panels = [...new Set(toggles.map(panelOf).filter((p): p is HTMLElement => !!p))];

    const setExpanded = (panel: HTMLElement, open: boolean) =>
      toggles
        .filter((t) => panelOf(t) === panel)
        .forEach((t) => t.setAttribute('aria-expanded', String(open)));

    const closeAll = () =>
      panels.forEach((p) => { p.classList.remove('open'); setExpanded(p, false); });

    toggles.forEach((t) => {
      t.addEventListener('click', (e) => {
        e.stopPropagation();
        const panel = panelOf(t);
        if (!panel) return;
        const willOpen = !panel.classList.contains('open');
        closeAll();
        if (willOpen) { panel.classList.add('open'); setExpanded(panel, true); }
      });
    });

    // Close after following a link, on outside click, or on Escape.
    root.querySelectorAll('.sh-panel a').forEach((a) => a.addEventListener('click', closeAll));
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-toc]')) closeAll();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });

    // ── Scrollspy: keep the section currently in view highlighted ───────
    const links = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => {
      links.set(a.dataset.tocLink!, a);
    });
    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);

    if (targets.length) {
      let activeId = '';
      const setActive = (id: string) => {
        if (id === activeId) return;
        activeId = id;
        links.forEach((a, key) => a.classList.toggle('is-active', key === id));
      };

      // Active = the last heading scrolled past a line just below both headers,
      // so a section stays lit for its whole length; force the last heading at
      // the very bottom so a short final section can still light up.
      const OFFSET = 110;
      const update = () => {
        const nearBottom =
          window.innerHeight + window.scrollY >= document.body.scrollHeight - 4;
        let current = targets[0].id;
        if (nearBottom) {
          current = targets[targets.length - 1].id;
        } else {
          for (const t of targets) {
            if (t.getBoundingClientRect().top <= OFFSET) current = t.id;
            else break;
          }
        }
        setActive(current);
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  });
</script>
