---
/**
 * Secondary docs header: a breadcrumb trail (left) and an on-this-page TOC
 * (right), rendered directly beneath the primary <Header> in DocsLayout.
 *
 * Layout (all widths): a full-width sticky bar whose two items align to the
 * screen edges — the breadcrumb sits under the header's hamburger icon, the TOC
 * button under the rightmost header icon — NOT to the prose column edges.
 *
 *  • Breadcrumb: a single horizontal line — [home icon] / <Section> /
 *    <Current page>. The <Section> and current-page segments are pills that open
 *    a shared grouping-tree popover (the same section→page groupings used by the
 *    Header hamburger menu and the homepage doc cards) so you can jump to any
 *    sibling page. The current page truncates with an ellipsis when space runs
 *    out so the trail always stays on one line.
 *
 *  • TOC: an "On this page ▾" button opening a popover of the page's h2/h3
 *    headings (nested), with a scrollspy that highlights the current section.
 *
 * Heading `id`s are auto-generated by Astro's markdown pipeline.
 */
import type { PageFrontmatter, NavSection } from '@typedefs/content';
import type { MarkdownHeading } from 'astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

interface Props {
  frontmatter: PageFrontmatter;
  headings: MarkdownHeading[];
}
const { frontmatter, headings } = Astro.props;

// ── Doc groupings (identical to HamburgerMenu / DocsPager / homepage cards) ──
const allPages = await getCollection('pages');
const sectionOrder = ['Getting Started', 'Configuration', 'Reference'];
const grouped = new Map<string, typeof allPages>();
for (const page of allPages) {
  const sec = page.data.section ?? 'Other';
  if (!grouped.has(sec)) grouped.set(sec, []);
  grouped.get(sec)!.push(page);
}
for (const pages of grouped.values()) {
  pages.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
}
const navSections: NavSection[] = [
  ...sectionOrder.filter((s) => grouped.has(s)),
  ...[...grouped.keys()].filter((s) => !sectionOrder.includes(s)),
].map((label) => ({
  label,
  pages: (grouped.get(label) ?? []).map((p) => ({ title: p.data.title, slug: p.data.slug })),
}));

const currentSlug = frontmatter.slug;
const section = frontmatter.section;

// `home` is a plain icon link (to /). The section and current page are pills
// (styled like the Header's `docs` badge) that open the shared grouping-tree
// popover, so either can be used to switch pages.
const menuCrumbs: { label: string; current?: boolean }[] = [
  ...(section ? [{ label: section }] : []),
  { label: frontmatter.title, current: true },
];

// ── TOC: h2 sections with nested h3s ───────────────────────────────
type TocNode = MarkdownHeading & { children: MarkdownHeading[] };
const toc: TocNode[] = [];
for (const h of headings) {
  if (h.depth === 2) toc.push({ ...h, children: [] });
  else if (h.depth === 3 && toc.length) toc[toc.length - 1].children.push(h);
}
const hasToc = toc.length > 0;
---

<div class="second-header" data-second-header>
  {/* ── Breadcrumb (left, under the hamburger icon) ───────────────── */}
  <nav class="sh-crumb" aria-label="Breadcrumb">
    <ol class="sh-crumb-trail">
      <li class="sh-crumb-item">
        <a href="/" class="sh-crumb-home" aria-label="Home">
          <Icon name="home" class="sh-home-icon" />
        </a>
      </li>

      {menuCrumbs.map((c) => (
        <li class:list={['sh-crumb-item', { 'sh-crumb-item--current': c.current }]}>
          <Icon name="chevron-right" class="sh-sep" aria-hidden="true" />
          <button
            type="button"
            class:list={['sh-crumb-seg', { 'sh-crumb-seg--current': c.current }]}
            data-sh-toggle
            aria-controls="sh-nav-panel"
            aria-expanded="false"
            aria-haspopup="true"
            aria-current={c.current ? 'page' : undefined}
            title={c.label}
          >
            <span class="sh-seg-label">{c.label}</span>
            {!c.current && <span class="sh-seg-ellipsis" aria-hidden="true">…</span>}
          </button>
        </li>
      ))}

      {/* Subtle affordance that the chip expands into a navigation popover.
          It's another trigger for the same panel, so it rotates whenever the
          tree is open — no matter which segment opened it. */}
      <li class="sh-crumb-item sh-crumb-expand-item">
        <button
          type="button"
          class="sh-crumb-expand"
          data-sh-toggle
          aria-controls="sh-nav-panel"
          aria-expanded="false"
          aria-haspopup="true"
          aria-label="Browse documentation"
        >
          <Icon name="chevron-down" class="sh-caret sh-expand-icon" />
        </button>
      </li>
    </ol>

    {/* Shared grouping tree — opened by the docs / section segments. */}
    <div id="sh-nav-panel" class="sh-panel sh-nav-panel" role="menu">
      {navSections.map((sec) => (
        <div class="sh-nav-group">
          <p class="sh-nav-label">{sec.label}</p>
          <ul class="sh-nav-list">
            {sec.pages.map((p) => (
              <li>
                <a
                  href={`/docs/${p.slug}`}
                  class:list={['sh-nav-link', { 'sh-nav-link--active': p.slug === currentSlug }]}
                  aria-current={p.slug === currentSlug ? 'page' : undefined}
                >{p.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </nav>

  {/* ── On-this-page TOC (right, under the last header icon) ───────── */}
  {hasToc && (
    <nav class="sh-toc" aria-label="On this page">
      <button
        type="button"
        class="sh-toc-btn"
        data-sh-toggle
        aria-controls="sh-toc-panel"
        aria-expanded="false"
        aria-haspopup="true"
      >
        <Icon name="list" class="sh-toc-icon" />
        <span class="sh-toc-btn-label">On this page</span>
        <span class="sh-caret" aria-hidden="true">▾</span>
      </button>

      <div id="sh-toc-panel" class="sh-panel sh-toc-panel">
        <p class="sh-toc-title">On this page</p>
        <ul class="sh-toc-list">
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="sh-toc-link" data-toc-link={h.slug}>{h.text}</a>
              {h.children.length > 0 && (
                <ul class="sh-toc-sub">
                  {h.children.map((c) => (
                    <li>
                      <a href={`#${c.slug}`} class="sh-toc-link sh-toc-link--sub" data-toc-link={c.slug}>{c.text}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )}
</div>

<style>
  .second-header {
    --sh-top: 56px;
    position: sticky;
    top: var(--sh-top);
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* Match the primary header's horizontal padding so the breadcrumb lands
       under the hamburger and the TOC button under the rightmost icon. */
    padding: 0.35rem 1.5rem;
    background: rgba(10, 13, 20, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  /* ── Breadcrumb ─────────────────────────────────────────────────── */
  .sh-crumb { position: relative; flex: 1 1 auto; min-width: 0; }
  /* The home icon and the section / current-page segments read as one breadcrumb
     unit — plain text, no box, just a shared baseline and hover treatment. */
  .sh-crumb-trail {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }
  .sh-crumb-item { display: inline-flex; align-items: center; gap: 0.4rem; flex-shrink: 0; min-width: 0; }
  .sh-crumb-item--current { flex-shrink: 1; min-width: 0; }
  /* Large, high-contrast caret between crumbs — intentionally taller than the
     text line so the separator is unmistakable. Fixed box keeps its width crisp. */
  .sh-sep {
    flex-shrink: 0;
    display: block;
    width: 22px;
    height: 22px;
    color: var(--text-muted);
  }

  /* Home icon + segments share one baseline and hover treatment. */
  .sh-crumb-home { display: inline-flex; align-items: center; color: var(--text-muted); transition: color 0.12s; }
  .sh-crumb-home:hover { color: var(--fish-periwinkle); }
  .sh-home-icon { display: block; width: 14px; height: 14px; }

  /* Section / current segments — plain text inside the chip (no own box). */
  .sh-crumb-seg {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    font: inherit;
    color: var(--text-muted);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: color 0.12s;
  }
  .sh-crumb-seg:hover { color: var(--fish-periwinkle); }
  .sh-crumb-seg--current { color: var(--text-primary); font-weight: 600; }
  .sh-crumb-seg--current:hover { color: var(--fish-periwinkle); }
  .sh-crumb-seg[aria-expanded='true'] { color: var(--fish-periwinkle); }
  .sh-seg-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sh-seg-ellipsis { display: none; }

  /* When the current title would overflow, the middle (section) crumb collapses
     to a still-clickable ellipsis to give the title room (toggled in script). */
  .sh-crumb-trail.is-collapsed .sh-crumb-seg:not(.sh-crumb-seg--current) .sh-seg-label { display: none; }
  .sh-crumb-trail.is-collapsed .sh-crumb-seg:not(.sh-crumb-seg--current) .sh-seg-ellipsis { display: inline; }
  .sh-caret { flex-shrink: 0; font-size: 0.58rem; transition: transform 0.15s; }
  [data-sh-toggle][aria-expanded='true'] .sh-caret { transform: rotate(180deg); }

  /* Expand affordance — a dim chevron at the end of the chip. */
  .sh-crumb-expand-item { flex-shrink: 0; }
  .sh-crumb-expand {
    display: inline-flex;
    align-items: center;
    padding: 0;
    margin-left: -0.05rem;
    background: none;
    border: 0;
    color: var(--text-dim);
    cursor: pointer;
    transition: color 0.12s;
  }
  .sh-crumb-expand:hover,
  .sh-crumb-expand[aria-expanded='true'] { color: var(--fish-periwinkle); }
  .sh-expand-icon { display: block; width: 12px; height: 12px; }

  /* ── TOC button ─────────────────────────────────────────────────── */
  .sh-toc { position: relative; flex-shrink: 0; }
  .sh-toc-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.28rem 0.6rem;
    cursor: pointer;
    transition: color 0.12s, border-color 0.12s;
  }
  .sh-toc-btn:hover { color: var(--text-primary); border-color: var(--fish-periwinkle); }
  .sh-toc-icon { display: block; width: 14px; height: 14px; flex-shrink: 0; }

  /* On narrow screens the TOC collapses to a compact icon-only dropdown so the
     breadcrumb keeps the width it needs. */
  @media (max-width: 640px) {
    .sh-toc-btn-label { display: none; }
    .sh-toc-btn { padding: 0.28rem 0.45rem; }
  }

  /* ── Popover panels (shared) ────────────────────────────────────── */
  .sh-panel {
    position: absolute;
    top: calc(100% + 6px);
    z-index: 30;
    max-height: 70vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
    display: none;
  }
  .sh-panel.open { display: block; }
  .sh-nav-panel { left: 0; min-width: 220px; padding: 0.75rem 0; }
  .sh-toc-panel { right: 0; min-width: 15rem; max-width: min(88vw, 22rem); padding: 0.5rem; }

  /* ── Grouping tree ──────────────────────────────────────────────── */
  .sh-nav-group { margin-bottom: 0.85rem; }
  .sh-nav-group:last-child { margin-bottom: 0; }
  .sh-nav-label {
    margin: 0 0 0.35rem;
    padding: 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .sh-nav-list { list-style: none; margin: 0; padding: 0; }
  .sh-nav-link {
    display: block;
    padding: 0.3rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.12s, background 0.12s;
  }
  .sh-nav-link:hover { color: var(--text-primary); background: var(--bg-2); }
  .sh-nav-link--active {
    color: var(--fish-periwinkle);
    border-left-color: var(--fish-periwinkle);
    background: rgba(78, 108, 250, 0.08);
  }

  /* ── TOC list ───────────────────────────────────────────────────── */
  .sh-toc-title {
    display: none; /* only shown in the wide-mode gutter rail */
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .sh-toc-list, .sh-toc-sub { list-style: none; margin: 0; padding: 0; }
  .sh-toc-sub { margin-left: 0.75rem; }
  /* Roomier spacing between top-level entries. */
  .sh-toc-list > li + li { margin-top: 0.4rem; }
  .sh-toc-link {
    display: block;
    padding: 0.24rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.35;
    color: var(--text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    overflow-wrap: anywhere; /* break long tokens (e.g. fish_lsp_… headings) */
    transition: color 0.12s, border-color 0.12s;
  }
  .sh-toc-link--sub { font-size: 0.72rem; color: var(--text-dim); }
  .sh-toc-link:hover { color: var(--text-primary); }
  .sh-toc-link.is-active {
    color: var(--fish-periwinkle);
    border-left-color: var(--fish-periwinkle);
  }

  /* ── Wide: float the two sections into the whitespace beside the prose ──
     Above this width there's room outside the article (max-w-4xl = 56rem) to
     show the breadcrumb in the left whitespace and the on-this-page list as a
     rail in the right whitespace. The bar becomes a full-width, zero-height
     sticky overlay with no border, and the two sections align to the SAME edges
     as the primary header's controls — the breadcrumb under the hamburger (left,
     1.5rem) and the TOC rail under the playground icon (right, 1.5rem). The
     breadcrumb is display-only here (not expandable); the TOC shows inline. */
  @media (min-width: 1500px) {
    .second-header {
      display: block;
      position: sticky;
      top: var(--sh-top);
      height: 0;
      padding: 0;
      background: transparent;
      backdrop-filter: none;
      border-bottom: 0;   /* no hr in gutter mode */
      pointer-events: none;
    }

    /* Breadcrumb → left whitespace, starting at the header's left edge (aligns
       with the hamburger). Capped to the whitespace so it never overlaps the
       article; the last entry wraps on spaces rather than truncating. */
    .sh-crumb {
      position: absolute;
      top: 3rem; /* ≈ .docs-main padding-top */
      left: 1.5rem;
      width: max-content;
      max-width: calc((100vw - 56rem) / 2 - 3rem);
      flex: none;
      pointer-events: none;
    }
    /* Let the last entry drop to its own line when the trail is too wide, then
       wrap on spaces within that line — rather than truncating. */
    .sh-crumb-trail {
      justify-content: flex-start;
      align-items: flex-start;
      flex-wrap: wrap;
      row-gap: 0.15rem;
    }
    .sh-crumb-expand { display: none; } /* no expand affordance when static */
    .sh-nav-panel { display: none !important; } /* never opens here */
    .sh-crumb-item--current { align-items: flex-start; }
    .sh-crumb-item--current .sh-seg-label {
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
      overflow-wrap: break-word;
    }

    /* On-this-page → right whitespace as a sticky rail, ending at the header's
       right edge (aligns with the playground icon). */
    .sh-toc {
      position: absolute;
      top: 3rem;
      right: 1.5rem;
      width: 14rem;
      max-width: calc((100vw - 56rem) / 2 - 3rem);
      flex: none;
      pointer-events: auto;
    }
    .sh-toc-btn { display: none; }
    .sh-toc-panel {
      position: static;
      display: block;
      min-width: 0;
      max-width: none;
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      max-height: calc(100vh - var(--sh-top) - 4rem);
      overflow-y: auto;
    }
    .sh-toc-title { display: block; }
    .sh-toc-list > li + li { margin-top: 0.15rem; } /* tighter in the rail */
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-second-header]').forEach((root) => {
    // ── Popover toggles (panel-centric: several triggers may share a panel) ──
    const toggles = [...root.querySelectorAll<HTMLElement>('[data-sh-toggle]')];
    const panelOf = (t: HTMLElement) =>
      document.getElementById(t.getAttribute('aria-controls') ?? '');
    const panels = [...new Set(toggles.map(panelOf).filter((p): p is HTMLElement => !!p))];

    const setExpanded = (panel: HTMLElement, open: boolean) =>
      toggles
        .filter((t) => panelOf(t) === panel)
        .forEach((t) => t.setAttribute('aria-expanded', String(open)));

    const closeAll = () =>
      panels.forEach((p) => { p.classList.remove('open'); setExpanded(p, false); });

    toggles.forEach((t) => {
      t.addEventListener('click', (e) => {
        e.stopPropagation();
        const panel = panelOf(t);
        if (!panel) return;
        const willOpen = !panel.classList.contains('open');
        closeAll();
        if (willOpen) { panel.classList.add('open'); setExpanded(panel, true); }
      });
    });

    // Close after following a link, on outside click, or on Escape.
    root.querySelectorAll('.sh-panel a').forEach((a) => a.addEventListener('click', closeAll));
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-second-header]')) closeAll();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });

    // ── Collapse the middle (section) crumb when the title needs the room ──
    // The current-page label truncates with an ellipsis; before letting that
    // happen, collapse the section crumb to a `…` so the title gets first claim
    // on the available width. Re-evaluated on resize.
    const trail = root.querySelector<HTMLElement>('.sh-crumb-trail');
    const currentLabel = root.querySelector<HTMLElement>(
      '.sh-crumb-item--current .sh-seg-label',
    );
    if (trail && currentLabel) {
      const fitCrumbs = () => {
        // Measure with the section expanded first, then collapse only if the
        // current title is actually being clipped.
        trail.classList.remove('is-collapsed');
        if (currentLabel.scrollWidth > currentLabel.clientWidth + 1) {
          trail.classList.add('is-collapsed');
        }
      };
      let crumbTicking = false;
      const onResize = () => {
        if (crumbTicking) return;
        crumbTicking = true;
        requestAnimationFrame(() => { fitCrumbs(); crumbTicking = false; });
      };
      window.addEventListener('resize', onResize, { passive: true });
      fitCrumbs();
    }

    // ── Scrollspy: keep the section currently in view highlighted ───────
    const links = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => {
      links.set(a.dataset.tocLink!, a);
    });
    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);

    if (targets.length) {
      let activeId = '';
      const setActive = (id: string) => {
        if (id === activeId) return;
        activeId = id;
        links.forEach((a, key) => a.classList.toggle('is-active', key === id));
      };

      // Active = the last heading scrolled past a line just below both headers,
      // so a section stays lit for its whole length; force the last heading at
      // the very bottom so a short final section can still light up.
      const OFFSET = 110;
      const update = () => {
        const nearBottom =
          window.innerHeight + window.scrollY >= document.body.scrollHeight - 4;
        let current = targets[0].id;
        if (nearBottom) {
          current = targets[targets.length - 1].id;
        } else {
          for (const t of targets) {
            if (t.getBoundingClientRect().top <= OFFSET) current = t.id;
            else break;
          }
        }
        setActive(current);
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  });
</script>
