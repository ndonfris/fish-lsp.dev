---
/**
 * Secondary docs header: a breadcrumb trail (left) and the <TableOfContents />
 * component (right), rendered directly beneath the primary <Header> in
 * DocsLayout.
 *
 * Layout (all widths): a full-width sticky bar whose two items align to the
 * screen edges — the breadcrumb sits under the header's hamburger icon, the TOC
 * button under the rightmost header icon — NOT to the prose column edges.
 *
 *  • Breadcrumb: a single horizontal line — [home icon] / <Section> /
 *    <Current page>. The <Section> and current-page segments are pills that open
 *    a shared grouping-tree popover (the same section→page groupings used by the
 *    Header hamburger menu and the homepage doc cards) so you can jump to any
 *    sibling page. The current page truncates with an ellipsis when space runs
 *    out so the trail always stays on one line.
 *
 *  • TOC: see TableOfContents.astro. It's rendered inside `.second-header` so
 *    it can position itself relative to that sticky bar at wide breakpoints.
 */
import type { PageFrontmatter, NavSection } from '@typedefs/content';
import type { MarkdownHeading } from 'astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import TableOfContents from '@components/TableOfContents.astro';

interface Props {
  frontmatter: PageFrontmatter;
  headings: MarkdownHeading[];
}
const { frontmatter, headings } = Astro.props;

// ── Doc groupings (identical to HamburgerMenu / DocsPager / homepage cards) ──
const allPages = await getCollection('pages');
const sectionOrder = ['Getting Started', 'Configuration', 'Reference'];
const grouped = new Map<string, typeof allPages>();
for (const page of allPages) {
  const sec = page.data.section ?? 'Other';
  if (!grouped.has(sec)) grouped.set(sec, []);
  grouped.get(sec)!.push(page);
}
for (const pages of grouped.values()) {
  pages.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
}
const navSections: NavSection[] = [
  ...sectionOrder.filter((s) => grouped.has(s)),
  ...[...grouped.keys()].filter((s) => !sectionOrder.includes(s)),
].map((label) => ({
  label,
  pages: (grouped.get(label) ?? []).map((p) => ({ title: p.data.title, slug: p.data.slug })),
}));

const currentSlug = frontmatter.slug;
const section = frontmatter.section;

// `home` is a plain icon link (to /). The section and current page are pills
// (styled like the Header's `docs` badge) that open the shared grouping-tree
// popover, so either can be used to switch pages.
const menuCrumbs: { label: string; current?: boolean }[] = [
  ...(section ? [{ label: section }] : []),
  { label: frontmatter.title, current: true },
];
---

<div class="second-header" data-second-header>
  {/* ── Breadcrumb (left, under the hamburger icon) ───────────────── */}
  <nav class="sh-crumb" aria-label="Breadcrumb">
    <ol class="sh-crumb-trail">
      <li class="sh-crumb-item">
        <a href="/" class="sh-crumb-home" aria-label="Home">
          <Icon name="home" class="sh-home-icon" />
        </a>
      </li>

      {menuCrumbs.map((c) => (
        <li class:list={['sh-crumb-item', { 'sh-crumb-item--current': c.current }]}>
          <Icon name="chevron-right" class="sh-sep" aria-hidden="true" />
          <button
            type="button"
            class:list={['sh-crumb-seg', { 'sh-crumb-seg--current': c.current }]}
            data-sh-toggle
            aria-controls="sh-nav-panel"
            aria-expanded="false"
            aria-haspopup="true"
            aria-current={c.current ? 'page' : undefined}
            title={c.label}
          >
            <span class="sh-seg-label">{c.label}</span>
            {!c.current && <span class="sh-seg-ellipsis" aria-hidden="true">…</span>}
          </button>
        </li>
      ))}

      {/* Subtle affordance that the chip expands into a navigation popover.
          It's another trigger for the same panel, so it rotates whenever the
          tree is open — no matter which segment opened it. */}
      <li class="sh-crumb-item sh-crumb-expand-item">
        <button
          type="button"
          class="sh-crumb-expand"
          data-sh-toggle
          aria-controls="sh-nav-panel"
          aria-expanded="false"
          aria-haspopup="true"
          aria-label="Browse documentation"
        >
          <Icon name="chevron-down" class="sh-caret sh-expand-icon" />
        </button>
      </li>
    </ol>

    {/* Shared grouping tree — opened by the docs / section segments. */}
    <div id="sh-nav-panel" class="sh-panel sh-nav-panel" role="menu">
      {navSections.map((sec) => (
        <div class="sh-nav-group">
          <p class="sh-nav-label">{sec.label}</p>
          <ul class="sh-nav-list">
            {sec.pages.map((p) => (
              <li>
                <a
                  href={`/docs/${p.slug}`}
                  class:list={['sh-nav-link', { 'sh-nav-link--active': p.slug === currentSlug }]}
                  aria-current={p.slug === currentSlug ? 'page' : undefined}
                >{p.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </nav>

  {/* ── On-this-page TOC (right, under the last header icon) ───────── */}
  <TableOfContents headings={headings} />
</div>

<style>
  .second-header {
    --sh-top: 56px;
    position: sticky;
    top: var(--sh-top);
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* Match the primary header's horizontal padding so the breadcrumb lands
       under the hamburger and the TOC button under the rightmost icon. */
    padding: 0.35rem 1.5rem;
    background: rgba(10, 13, 20, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  /* ── Breadcrumb ─────────────────────────────────────────────────── */
  .sh-crumb { position: relative; flex: 1 1 auto; min-width: 0; }
  /* The home icon and the section / current-page segments read as one breadcrumb
     unit — plain text, no box, just a shared baseline and hover treatment. */
  .sh-crumb-trail {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }
  .sh-crumb-item { display: inline-flex; align-items: center; gap: 0.4rem; flex-shrink: 0; min-width: 0; }
  .sh-crumb-item--current { flex-shrink: 1; min-width: 0; }
  /* Large, high-contrast caret between crumbs — intentionally taller than the
     text line so the separator is unmistakable. Fixed box keeps its width crisp. */
  .sh-sep {
    flex-shrink: 0;
    display: block;
    width: 22px;
    height: 22px;
    color: var(--text-muted);
  }

  /* Home icon + segments share one baseline and hover treatment. */
  .sh-crumb-home {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    color: var(--text-muted);
    transition: color 0.12s;
  }
  .sh-crumb-home:hover { color: var(--fish-periwinkle); }
  .sh-home-icon { display: block; width: 14px; height: 14px; }

  /* Section / current segments — plain text inside the chip (no own box). */
  .sh-crumb-seg {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    font: inherit;
    color: var(--text-muted);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: color 0.12s;
  }
  .sh-crumb-seg:hover { color: var(--fish-periwinkle); }
  .sh-crumb-seg--current { color: var(--text-primary); font-weight: 600; }
  .sh-crumb-seg--current:hover { color: var(--fish-periwinkle); }
  .sh-crumb-seg[aria-expanded='true'] { color: var(--fish-periwinkle); }
  .sh-seg-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sh-seg-ellipsis { display: none; }

  /* When the current title would overflow, the middle (section) crumb collapses
     to a still-clickable ellipsis to give the title room (toggled in script). */
  .sh-crumb-trail.is-collapsed .sh-crumb-seg:not(.sh-crumb-seg--current) .sh-seg-label { display: none; }
  .sh-crumb-trail.is-collapsed .sh-crumb-seg:not(.sh-crumb-seg--current) .sh-seg-ellipsis { display: inline; }
  .sh-caret { flex-shrink: 0; font-size: 0.58rem; transition: transform 0.15s; }
  [data-sh-toggle][aria-expanded='true'] .sh-caret { transform: rotate(180deg); }

  /* Expand affordance — a dim chevron at the end of the chip. */
  .sh-crumb-expand-item { flex-shrink: 0; }
  .sh-crumb-expand {
    display: inline-flex;
    align-items: center;
    padding: 0;
    margin-left: -0.05rem;
    background: none;
    border: 0;
    color: var(--text-dim);
    cursor: pointer;
    transition: color 0.12s;
  }
  .sh-crumb-expand:hover,
  .sh-crumb-expand[aria-expanded='true'] { color: var(--fish-periwinkle); }
  .sh-expand-icon { display: block; width: 12px; height: 12px; }

  /* ── Popover panels (shared) ────────────────────────────────────── */
  .sh-panel {
    position: absolute;
    top: calc(100% + 6px);
    z-index: 30;
    max-height: 70vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
    display: none;
  }
  .sh-panel.open { display: block; }
  .sh-nav-panel { left: 0; min-width: 220px; padding: 0.75rem 0; }

  /* ── Grouping tree ──────────────────────────────────────────────── */
  .sh-nav-group { margin-bottom: 0.85rem; }
  .sh-nav-group:last-child { margin-bottom: 0; }
  .sh-nav-label {
    margin: 0 0 0.35rem;
    padding: 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .sh-nav-list { list-style: none; margin: 0; padding: 0; }
  .sh-nav-link {
    display: block;
    padding: 0.3rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.12s, background 0.12s;
  }
  .sh-nav-link:hover { color: var(--text-primary); background: var(--bg-2); }
  .sh-nav-link--active {
    color: var(--fish-periwinkle);
    border-left-color: var(--fish-periwinkle);
    background: rgba(78, 108, 250, 0.08);
  }

  /* ── Wide: keep the second header row, promote TOC into the right gutter ──
     Above this width there's room outside the article (max-w-4xl = 56rem) to
     show the on-this-page list as an always-visible rail in the right whitespace.
     The second header remains a real sticky bar with its separator and contains
     only the breadcrumb controls. */
  @media (min-width: 1500px) {
    .second-header {
      position: sticky;
      top: var(--sh-top);
      justify-content: flex-start;
    }

    /* Breadcrumb stays in the second header. Let long titles wrap instead of
       forcing a truncation when there is ample horizontal space. */
    .sh-crumb {
      flex: 1 1 auto;
      max-width: min(100%, 56rem);
    }
    .sh-crumb-trail {
      justify-content: flex-start;
      align-items: center;
      flex-wrap: wrap;
      row-gap: 0.15rem;
    }
    .sh-crumb-item--current .sh-seg-label {
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
      overflow-wrap: break-word;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-second-header]').forEach((root) => {
    // ── Popover toggles (panel-centric: several triggers may share a panel) ──
    const toggles = [...root.querySelectorAll<HTMLElement>('[data-sh-toggle]')];
    const panelOf = (t: HTMLElement) =>
      document.getElementById(t.getAttribute('aria-controls') ?? '');
    const panels = [...new Set(toggles.map(panelOf).filter((p): p is HTMLElement => !!p))];

    const setExpanded = (panel: HTMLElement, open: boolean) =>
      toggles
        .filter((t) => panelOf(t) === panel)
        .forEach((t) => t.setAttribute('aria-expanded', String(open)));

    const closeAll = () =>
      panels.forEach((p) => { p.classList.remove('open'); setExpanded(p, false); });

    toggles.forEach((t) => {
      t.addEventListener('click', (e) => {
        e.stopPropagation();
        const panel = panelOf(t);
        if (!panel) return;
        const willOpen = !panel.classList.contains('open');
        closeAll();
        if (willOpen) { panel.classList.add('open'); setExpanded(panel, true); }
      });
    });

    // Close after following a link, on outside click, or on Escape.
    root.querySelectorAll('.sh-panel a').forEach((a) => a.addEventListener('click', closeAll));
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-second-header]')) closeAll();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });

    // ── Collapse the middle (section) crumb when the title needs the room ──
    // The current-page label truncates with an ellipsis; before letting that
    // happen, collapse the section crumb to a `…` so the title gets first claim
    // on the available width. Re-evaluated on resize.
    const trail = root.querySelector<HTMLElement>('.sh-crumb-trail');
    const currentLabel = root.querySelector<HTMLElement>(
      '.sh-crumb-item--current .sh-seg-label',
    );
    if (trail && currentLabel) {
      const fitCrumbs = () => {
        // Measure with the section expanded first, then collapse only if the
        // current title is actually being clipped.
        trail.classList.remove('is-collapsed');
        if (currentLabel.scrollWidth > currentLabel.clientWidth + 1) {
          trail.classList.add('is-collapsed');
        }
      };
      let crumbTicking = false;
      const onResize = () => {
        if (crumbTicking) return;
        crumbTicking = true;
        requestAnimationFrame(() => { fitCrumbs(); crumbTicking = false; });
      };
      window.addEventListener('resize', onResize, { passive: true });
      fitCrumbs();
    }
  });
</script>
