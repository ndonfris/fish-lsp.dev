<hr class="min-h-[1.5px] max-h-[1.75px] my-0.5! mr-10! dotted"/>
<style>
.custom-spaced-dots {
  height: 2px; /* The thickness of the dots */
  background-image: linear-gradient(to right, var(--color-fish-alt-white) 25%, transparent);
  background-position: bottom;
  background-size: 4px 4px; /* First number controls dot spacing (10px wide pattern) */
  background-repeat: repeat-x;
}

.dotted {
  border: none;               /* Removes the default solid border style */
  border-top: 1px dashed rgba(175, 175, 255, 50%); /* Defines thickness, style, and color */
  color: transparent;                /* Clears legacy browser coloring */
  background-color: transparent;     /* Clears legacy browser backgrounds */
}

</style>

