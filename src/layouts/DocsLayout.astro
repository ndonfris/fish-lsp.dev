---
import '@theme/global.css';
import BaseHead        from '@components/BaseHead.astro';
import Header          from '@components/Header.astro';
import TableOfContents from '@components/TableOfContents.astro';
import Container       from '@components/Container.astro';
import Footer          from '@components/Footer.astro';
import DocsPager       from '@components/DocsPager.astro';
import { Icon } from 'astro-icon/components';
import type { PageFrontmatter } from '@typedefs/content';
import type { MarkdownHeading } from 'astro';

interface Props {
  frontmatter: PageFrontmatter;
  /** Section/subsection headings of the rendered page, for the on-this-page TOC. */
  headings?: MarkdownHeading[];
  /** Repo-relative source path, forwarded to the footer's edit link. */
  editPath?: string;
}

const { frontmatter, headings = [], editPath } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead title={`${frontmatter.title} — fish-lsp`} description={frontmatter.description} />
</head>
<body>

  <Header variant="docs" />

  <div class="docs-body">

    {/* ── EXPERIMENT: SecondHeader (breadcrumb bar) removed; TOC docked
        top-right, sticky under the header, no full-width bar. ── */}
    <div class="toc-dock">
      <TableOfContents headings={headings} />
    </div>

    <!-- Sidebar nav + hamburger drawer now live in HamburgerMenu.astro (in the Header) -->

    <!-- ── Main content: centered container; drawer floats over the margin ── -->
    <main class="docs-main">
      <Container class="max-w-4xl">
        {/* data-pagefind-body scopes the search index to docs content only
            (the homepage and chrome are excluded). */}
        <article class="prose" data-pagefind-body data-pagefind-meta={`title:${frontmatter.title}`}>
          <slot />
        </article>

        <DocsPager currentSlug={frontmatter.slug} />
      </Container>
    </main>
  </div>

  <Footer editPage editPath={editPath} />

  <!-- Server-rendered copy icon, cloned into each code block by the script below -->
  <template id="copy-icon-tmpl"><Icon name="copy" /></template>

</body>
</html>

<script>
  // ── Mermaid diagrams (```mermaid fences → <pre class="mermaid">) ──
  import mermaid from 'mermaid';
  if (document.querySelector('.prose .mermaid')) {
    // `theme: 'base'` + explicit themeVariables so the diagram matches the
    // site palette (global.css tokens). The built-in 'dark' theme rendered
    // edge labels (e.g. "LSP request") with a light background + light text,
    // which collapsed to white-on-white inside <foreignObject> on iOS Safari.
    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      securityLevel: 'loose',
      fontFamily: "'JetBrains Mono', monospace",
      themeVariables: {
        background:          '#0a0d14',  // --bg-0
        primaryColor:        '#141829',  // node fill (--bg-2)
        primaryBorderColor:  '#4e6cfa',  // --fish-periwinkle
        primaryTextColor:    '#e8ecf8',  // --fish-white
        lineColor:           '#4e6cfa',  // arrows (--fish-periwinkle)
        edgeLabelBackground: '#1c2236',  // solid dark box (--bg-3)
        tertiaryTextColor:   '#e8ecf8',  // edge-label text (--fish-white)
        // sequenceDiagram notes ("Note over …") — keep them dark, not the
        // built-in yellow.
        noteBkgColor:        '#1c2236',  // --bg-3
        noteTextColor:       '#e8ecf8',  // --fish-white
        noteBorderColor:     '#4e6cfa',  // --fish-periwinkle
        fontFamily:          "'JetBrains Mono', monospace",
      },
      // `.labelBkg` is mermaid's opaque backing box for edge labels; the
      // rounded corners are cosmetic. Horizontal padding and the empty-edge
      // cleanup are done in JS below (mermaid derives the box size from
      // measured text, so CSS padding can't widen it).
      themeCSS: `
        .labelBkg { background: #1c2236 !important; }
        span.edgeLabel { border-radius: 3px; }
      `,
    });
    mermaid.run({ querySelector: '.prose .mermaid' }).then(() => {
      // mermaid sizes each edge-label <foreignObject> to the raw text, so the
      // opaque backing box hugs the text with no breathing room. Widen each
      // one (and re-center it) for horizontal padding, and drop the backing
      // box on label-less edges — at full opacity it showed as a stray gray
      // square. Edge labels are decorative overlays on the edge midpoint, so
      // resizing them never disturbs the arrow paths.
      const PAD_X = 14;
      for (const g of document.querySelectorAll<SVGGElement>('.prose .mermaid .edgeLabel')) {
        const fo = g.querySelector('foreignObject');
        if (!fo) continue;
        const p = g.querySelector('p');
        if (!p || !p.textContent?.trim()) {
          g.querySelector('.labelBkg')?.remove();
          continue;
        }
        const w = parseFloat(fo.getAttribute('width') ?? '0');
        const newW = w + PAD_X * 2;
        fo.setAttribute('width', String(newW));
        // The visible box is a shrink-to-fit table-cell anchored to the left of
        // the foreignObject; stretch it to the new width and center its text so
        // the padding lands on both sides.
        const bkg = fo.querySelector<HTMLElement>('.labelBkg');
        if (bkg) {
          // mermaid caps the box at `max-width: 200px` and switches long
          // labels to a wrapping `display: table`; override both so the box
          // fills the widened foreignObject and stays on one centered line.
          bkg.style.width = `${newW}px`;
          bkg.style.maxWidth = 'none';
          bkg.style.whiteSpace = 'nowrap';
          bkg.style.textAlign = 'center';
        }
        // The label group is centered via `translate(-w/2, …)`; nudge it left
        // by PAD_X so the wider box stays centered on the edge.
        const label = fo.closest<SVGGElement>('.label');
        const t = label?.getAttribute('transform');
        const m = t?.match(/translate\(\s*(-?[\d.]+)[ ,]+(-?[\d.]+)\s*\)/);
        if (label && m) {
          label.setAttribute('transform', `translate(${parseFloat(m[1]) - PAD_X}, ${m[2]})`);
        }
      }
    });
  }
</script>

<script>
  // Wrap each Shiki code block and add an icon copy-to-clipboard button.
  const iconTmpl = document.getElementById('copy-icon-tmpl') as HTMLTemplateElement | null;
  const copyIcon = iconTmpl?.innerHTML ?? '';

  // `.plain` blocks opt out of the code-block theme (inline-code styling, no
  // copy button), so they're excluded from the wrapper/button enhancer.
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre:not(.mermaid):not(.plain)')) {
    // CodeTabs / CodeFile / CommandPrompt render their own frame around
    // highlighted blocks; skip their Shiki <pre>s so they aren't
    // double-wrapped/double-buttoned.
    if (pre.closest('[data-codetabs], [data-codefile], [data-command-prompt], [data-command-details], [data-command-seq], [data-xprompt]')) continue;
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);
    wrapper.appendChild(pre);

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.innerHTML = copyIcon;
    btn.setAttribute('aria-label', 'Copy code to clipboard');
    wrapper.appendChild(btn);

    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      const text = (code?.textContent ?? pre.textContent ?? '').replace(/\n$/, '');
      try {
        await navigator.clipboard.writeText(text);
        btn.classList.add('is-copied');
        window.setTimeout(() => btn.classList.remove('is-copied'), 1500);
      } catch { /* clipboard unavailable */ }
    });

    // GitHub-style: hide the copy button while scrolling the code horizontally,
    // restore it shortly after scrolling stops.
    let scrollTimer: number;
    pre.addEventListener('scroll', () => {
      btn.classList.add('is-scrolling');
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => btn.classList.remove('is-scrolling'), 350);
    }, { passive: true });
  }
</script>

<script>
  // Give each h2/h3 subheading a hover-revealed "#" permalink (the
  // "click to grab the section URL" pattern common on doc sites like
  // Docusaurus/VitePress/MDN). Ids are already present on the rendered
  // headings (Astro's markdown pipeline assigns them; <TableOfContents>
  // links to the same slugs), so this just needs to append a real <a>.
  for (const heading of document.querySelectorAll<HTMLHeadingElement>('.prose h2[id], .prose h3[id]')) {
    const link = document.createElement('a');
    link.className = 'heading-anchor';
    link.href = `#${heading.id}`;
    link.textContent = '#';
    link.setAttribute('aria-label', `Link to "${heading.textContent}"`);
    heading.appendChild(link);
  }
</script>

<style>
/* ── Layout shell ─────────────────────────────────────────────── */
/* The sticky header lives in src/components/Header.astro */
html, body { margin: 0; width: 100%; }

/* ── Body (drawer + main share one scroll container) ──────────── */
.docs-body { position: relative; min-height: calc(100vh - 56px); }

/* The nav drawer + backdrop now live in src/components/HamburgerMenu.astro */

/* ── EXPERIMENT: TOC dock (replaces SecondHeader's breadcrumb bar) ──
   No visible bar/background — just a sticky positioning host so
   <TableOfContents> can dock itself at the top-right, under the primary
   header's rightmost icon, the same way it did inside .second-header. */
.toc-dock {
  --sh-top: 56px;
  position: sticky;
  top: var(--sh-top);
  z-index: 20;
  display: flex;
  justify-content: flex-end;
  padding: 0.35rem 1.5rem 0;
}

/* ── Main: full width; inner content is centered by <Container> ──
   (mx-auto max-w-4xl). The drawer floats over the left margin. */
.docs-main {
  width: 100%;
  box-sizing: border-box;
  padding: 1rem 0 4rem;
}

@media (max-width: 768px) {
  .docs-main { padding: 0.5rem 0; }
}

/* Mobile: <Header> switches to `position: fixed` at 640px (see Header.astro),
   so the sticky toc-dock now docks directly under a fixed bar instead of a
   bar that scrolls away with the page. Give it more clearance there so the
   "On this page" button doesn't crowd the hamburger menu row above it. */
@media (max-width: 640px) {
  .toc-dock { padding-top: 1rem; }
}

/* The footer is the shared src/components/Footer.astro (<Footer editPage />) */
</style>
