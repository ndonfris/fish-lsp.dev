{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*":    ["src/layouts/*"],
      "@pages/*":      ["src/pages/*"],
      "@icons/*":      ["src/icons/*"],
      "@content/*":    ["src/content/*"],
      "@typedefs/*":   ["src/types/*"],
      "@theme/*":      ["src/styles/*"]
    }
  }
}
