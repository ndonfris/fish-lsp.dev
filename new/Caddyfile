:8080 {
    root * /srv
    file_server

    # Clean URLs: /page/installation → /page/installation/index.html
    try_files {path} {path}/index.html

    redir /page /page/installation 302

    @hashed path_regexp /_astro/.*
    header @hashed Cache-Control "public, max-age=31536000, immutable"

    encode gzip
}
