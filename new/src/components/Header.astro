---
/**
 * Shared sticky site header used by both the homepage (Layout) and the docs
 * (DocsLayout). Replaces the previously duplicated `home-nav` / `docs-topbar`
 * markup + logo CSS.
 *
 * variant:
 *   'home' → logo links to "/", shows a "Docs" link, Install jumps to #install
 *   'docs' → logo links to the site root, shows a "docs" badge, Install → npm
 *
 * The header spans full width (it is NOT wrapped in the centered Container).
 */
import { DOCS_ORIGIN } from '../config';

interface Props {
  variant?: 'home' | 'docs';
}
const { variant = 'home' } = Astro.props;
const isDocs = variant === 'docs';

const logoHref    = isDocs ? 'https://fish-lsp.dev' : '/';
const docsHref    = `${DOCS_ORIGIN}/page/installation`;
const installHref = isDocs ? 'https://www.npmjs.com/package/fish-lsp' : '#install';
---
<header class="site-header">
  <div class="site-header__left">
    {isDocs && (
      <button
        type="button"
        class="site-header__menu"
        aria-label="Toggle documentation menu"
        @click="sidebarOpen = !sidebarOpen"
        :aria-expanded="sidebarOpen ? 'true' : 'false'"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>
    )}
    <a href={logoHref} class="site-header__logo" aria-label="fish-lsp home">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
           class="logo-icon" aria-hidden="true">
        <path fill="currentColor" d="M19.11 5H21V3H3v2h1.89A9.93 9.93 0 0 0 2 12c0 3.97 2.31 7.39 5.66 9h8.68A9.973 9.973 0 0 0 22 12c0-2.73-1.11-5.2-2.89-7m-5.86 12c-1.16 0-2.19-.36-2.92-.83c-.66.83-2 .83-3.33.83c1.1 0 1.5-1.12 1.5-2.5S8.1 12 7 12c1.33 0 2.67 0 3.37.91c.69-.55 1.72-.91 2.88-.91c2.07 0 3.75 1.12 3.75 2.5S15.32 17 13.25 17M16 7c-2.44 1.71-5.56 1.71-8 0c-.94.66-2 1.09-3.05 1.25c.36-.67.82-1.29 1.37-1.84L7.7 5h8.6l1.38 1.41a7.87 7.87 0 0 1 1.37 1.84A7.272 7.272 0 0 1 16 7"/>
      </svg>
      <span class="logo-wordmark"><span class="logo-accent">fish-lsp</span></span>
    </a>
    {isDocs && <span class="site-header__badge">docs</span>}
  </div>

  <nav class="site-header__right">
    {!isDocs && <a href={docsHref} class="site-header__link">Docs</a>}
    <a href="https://fish-lsp.dev/playground" target="_blank" rel="noopener noreferrer"
       class="site-header__playground">▶ Playground</a>
    <a href="https://github.com/ndonfris/fish-lsp" target="_blank" rel="noopener noreferrer"
       class="site-header__link site-header__link--hide-xs">GitHub</a>
    <a href={installHref} class="site-header__cta">Install →</a>
  </nav>
</header>

<style>
.site-header {
  position: sticky; top: 0; z-index: 40;
  background: rgba(10,13,20,0.95); backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border); height: 56px;
  display: flex; align-items: center; padding: 0 1.5rem; gap: 1rem;
}
.site-header__left  { display: flex; align-items: center; gap: 0.6rem; flex: 1; min-width: 0; }
.site-header__right { display: flex; align-items: center; gap: 1rem; flex-shrink: 0; }

/* Hamburger: shown only while the sidebar is a collapsible drawer (≤1240px) */
.site-header__menu {
  display: none;
  align-items: center; justify-content: center;
  background: none; border: none; cursor: pointer;
  color: var(--text-muted); padding: 0.25rem; border-radius: 4px;
  transition: color 0.12s;
}
.site-header__menu:hover { color: var(--fish-blue); }
@media (max-width: 1240px) { .site-header__menu { display: inline-flex; } }

/* LogoMark */
.site-header__logo {
  display: flex; align-items: center; gap: 0.5rem;
  text-decoration: none; color: var(--fish-blue); flex-shrink: 0;
}
.logo-wordmark {
  font-family: var(--font-mono); font-weight: 600;
  font-size: 0.9rem; color: var(--text-primary); white-space: nowrap;
}
.logo-accent { color: var(--fish-blue); }
.logo-icon   { flex-shrink: 0; }

/* Mobile: stack wordmark above icon */
@media (max-width: 540px) {
  .site-header__logo { flex-direction: column; align-items: center; gap: 1px; line-height: 1; }
  .logo-wordmark     { font-size: 0.76rem; }
}

.site-header__badge {
  font-family: var(--font-mono); font-size: 0.62rem;
  color: var(--text-dim); background: var(--bg-3);
  border: 1px solid var(--border); border-radius: 4px;
  padding: 0.1em 0.5em; letter-spacing: 0.05em; white-space: nowrap;
}
@media (max-width: 480px) { .site-header__badge { display: none; } }

.site-header__link {
  font-family: var(--font-mono); font-size: 0.8rem;
  color: var(--text-muted); text-decoration: none; transition: color 0.12s;
  white-space: nowrap;
}
.site-header__link:hover { color: var(--text-primary); }
.site-header__link--hide-xs { display: none; }
@media (min-width: 560px) { .site-header__link--hide-xs { display: block; } }

.site-header__playground {
  font-family: var(--font-mono); font-size: 0.78rem;
  color: var(--fish-cyan); text-decoration: none; white-space: nowrap;
  transition: color 0.12s;
}
.site-header__playground:hover { color: white; }

.site-header__cta {
  font-family: var(--font-mono); font-size: 0.78rem;
  background: var(--fish-blue); color: white;
  padding: 0.3rem 0.7rem; border-radius: 5px;
  text-decoration: none; white-space: nowrap; transition: background 0.15s;
}
.site-header__cta:hover { background: var(--fish-blue-dim); }
</style>
