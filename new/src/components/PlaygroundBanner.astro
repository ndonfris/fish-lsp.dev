---
/**
 * "Try the playground" call-to-action banner for the homepage.
 * Self-contained, styled entirely with Tailwind utilities (brand tokens from
 * @theme in global.css). Centered; links to the live playground.
 */
const PLAYGROUND_URL = 'https://fish-lsp.dev/playground';
---
<a
  href={PLAYGROUND_URL}
  target="_blank"
  rel="noopener noreferrer"
  class="group mx-auto flex max-w-auto items-center gap-5 rounded-xl border border-fish-cyan/25
         bg-linear-to-r from-surface-1 via-surface-2 to-surface-1 px-6 py-5 no-underline
         transition-colors hover:border-fish-cyan hover:bg-none hover:bg-fish-cyan/[0.06]
         max-sm:flex-col max-sm:gap-[0.85rem] max-sm:p-5 max-sm:text-center"
>
  <span
    class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-[10px]
           bg-fish-cyan/[0.12] text-[1.05rem] text-fish-cyan max-sm:hidden"
    aria-hidden="true"
  >▶</span>

  <div class="flex-1 min-w-0 text-left max-sm:text-center">
    <span class="mb-1.5 inline-block rounded-full bg-fish-cyan px-2 py-[0.1rem] font-mono
                 text-[0.58rem] font-bold uppercase tracking-[0.12em] text-surface-0">New</span>
    <p class="m-0 text-base leading-[1.4] text-ink">
      Try out the <strong class="font-semibold text-fish-cyan">fish-lsp playground</strong> in your browser
    </p>
    <p class="mt-1 text-[0.8rem] text-ink-muted max-sm:hidden">
      Powered by Monaco Editor and a live language server — no install required.
    </p>
  </div>

  <span
    class="flex-shrink-0 whitespace-nowrap rounded-md border border-fish-cyan/30 px-[0.85rem]
           py-[0.45rem] font-mono text-[0.78rem] text-fish-cyan transition-colors
           group-hover:border-fish-cyan group-hover:bg-fish-cyan/10"
  >Open Playground ↗</span>
</a>
